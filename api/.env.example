# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://root:password@localhost:3306/legalconnect"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Google APIs (OAuth2 for Calendar) ───────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Gemini AI ───────────────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"

# ─── Firebase (FCM Push Notifications) ───────────────────────────────────────
# Paste your Firebase service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ─── Admin Panel ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@legalconnect.pk"
ADMIN_PASSWORD="Admin@123!"
ADMIN_COOKIE_SECRET="your-admin-cookie-secret-min-32-chars!"

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV="development"
