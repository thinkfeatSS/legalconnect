# --- Database ---
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME?ssl=true"

# --- JWT ---
JWT_SECRET="generate-a-strong-random-secret-min-32-chars"
JWT_EXPIRES_IN="7d"

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# --- Redis (optional) ---
# REDIS_URL=redis://localhost:6379

# --- Google APIs ---
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- Gemini AI ---
GEMINI_API_KEY="your-gemini-api-key"

# --- Firebase (FCM Push Notifications) ---
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# --- Admin Panel ---
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="YourStrongPassword"
ADMIN_COOKIE_SECRET="generate-a-strong-random-secret-min-32-chars"

# --- App (AWS Lightsail + PM2) ---
# PM2 ecosystem.config.js sets PORT=3000 and NODE_ENV=production automatically.
PORT=3000
NODE_ENV="production"
